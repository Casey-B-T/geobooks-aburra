# Copia este archivo como ".env" y completa los valores.
# true  = datos de ejemplo, sin base de datos
# false = usa Supabase con DATABASE_URL
USE_MOCK=true

# Supabase > Project Settings > Database > Connection string > Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:6543/postgres
